---
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import cvData from '../data/cv.json';
import '../styles/global.css';
const { sections } = cvData;

const icons = {
  "Profile": "fa-user",
  "Tools and Technologies": "fa-tools",
  "Professional Experience": "fa-briefcase",
  "Featured Personal Projects": "fa-code",
  "Education": "fa-graduation-cap",
  "Skills": "fa-star",
  "Languages and Other Info": "fa-globe"
};


---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Miguel de Mendoza - Motion Graphics y Full Stack Developer</title>
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
  <div class="container">
    <Header />

    {sections.map(section => (
      <Section title={section.title} content={section.content} icon={icons[section.title]} />
    ))}
  </div>

  <button id="scroll-top" title="Volver arriba">
    <i class="fas fa-arrow-up"></i>
  </button>

  <script>
    const scrollTopBtn = document.getElementById('scroll-top');
    window.addEventListener('scroll', () => {
      scrollTopBtn.classList.toggle('visible', window.scrollY > 300);
    });
    scrollTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  </script>
</body>
</html>